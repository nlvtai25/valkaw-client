# build output
valkaw-client/.gradle/
valkaw-client/build/
valkaw-launcher/build/
valkaw-launcher/frontend/node_modules/
valkaw-launcher/frontend/dist/
# wails writes this cache file on every build
valkaw-launcher/frontend/package.json.md5

# build inputs that ship as release assets, not as source

# local notes and read-only vanilla reference
AGENTS.md
HANDOFF.md
docs/
.directory
MCP-Reborn/

# editors and OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# local workspace settings (do not commit)
.opencode/
.design-os/

# local game-run artifacts (dev/test)
/cache/
/config/
/logs/

# local Crush harness config
.crushrc

# local Crush harness DB (do not commit)
crush.db
crush.db-shm
crush.db-wal
init

# per-version client snapshots: tracked as source (src/, gradle files, libs/);
# generated build output and Gradle caches are excluded.
/*/valkaw-client/build/
/*/valkaw-client/.gradle/

# generated assets (not source)
graphify-out/

# built client artifacts (see version/README.md)
version/*.jar

# stray launcher binaries and frontend bundles
valkaw-launcher/valkaw-launcher
valkaw-launcher-win/valkaw-launcher-win.exe
valkaw-launcher-win/frontend/dist/
valkaw-launcher-win/build/
